# Export the variables needed by scripts/run_sf_training.sh or run_sf_test.sh.
# These scripts do not automatically load this file.
CUDA_VISIBLE_DEVICES=0,1,2,3
MANAGER_MODEL=/path/to/local/base-model
ANSWER_MODEL=/path/to/local/base-model
ANSWER_ADAPTER=/path/to/trained-answer-adapter
# MANAGER_ADAPTER=/path/to/selected-manager-adapter
HF_HUB_OFFLINE=1
MEMORY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_EMBEDDING_DEVICE=cpu

# Teacher fact extraction only; not used for memory construction or training.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY

# Optional post-test Judge; disabled by default.
RUN_JUDGE=0
# JUDGE_MODEL_PATH=/path/to/local/gpt-oss-20b
